{
  "functions": {
    "api/page.js": {
      "includeFiles": "{build/index.html,server/render.cjs}",
      "maxDuration": 30
    },
    "api/sitemap.js": {
      "includeFiles": "server/render.cjs",
      "maxDuration": 30
    },
    "api/catalog.js": {
      "includeFiles": "server/render.cjs",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "printin3d.in"
        }
      ],
      "headers": {
        "Location": "https://www.printin3d.in/$1"
      },
      "status": 308
    },
    {
      "src": "^/index.html$",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "^/$",
      "dest": "/api/page?path="
    },
    {
      "src": "^/sitemap.xml$",
      "dest": "/api/sitemap"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/page?path=$1"
    }
  ]
}
